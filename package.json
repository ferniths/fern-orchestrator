{
    "name": "fern-orchestrator",
    "productName": "Fern Orchestrator",
    "version": "0.1.0",
    "description": "Local-first AI automation command center: rough idea -> refiner -> planner -> DAG of real OpenCode workers -> synthesis -> review loops -> final result.",
    "license": "MIT",
    "private": true,
    "type": "module",
    "main": "out/main/index.js",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "dev": "electron-vite dev",
        "build": "electron-vite build",
        "preview": "electron-vite preview",
        "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
        "lint": "eslint .",
        "format": "prettier --write .",
        "test": "vitest run",
        "test:watch": "vitest",
        "rebuild": "electron-rebuild -f -w better-sqlite3",
        "dist:win": "npm run build && electron-builder --win",
        "dist:linux": "npm run build && electron-builder --linux",
        "e2e:live": "node scripts/e2e-live.mjs",
        "smoke": "node scripts/harness-smoke.mjs",
        "smoke:parallel": "node scripts/harness-smoke.mjs --parallel"
    },
    "dependencies": {
        "@opencode-ai/sdk": "1.18.33",
        "better-sqlite3": "^13.0.3",
        "chokidar": "^5.0.0",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@electron/rebuild": "^4.2.0",
        "@radix-ui/react-dialog": "^1.1.23",
        "@radix-ui/react-dropdown-menu": "^2.1.24",
        "@radix-ui/react-popover": "^1.1.23",
        "@radix-ui/react-progress": "^1.1.16",
        "@radix-ui/react-scroll-area": "^1.2.18",
        "@radix-ui/react-select": "^2.3.7",
        "@radix-ui/react-separator": "^1.1.15",
        "@radix-ui/react-slot": "^1.3.3",
        "@radix-ui/react-switch": "^1.3.7",
        "@radix-ui/react-tabs": "^1.1.21",
        "@radix-ui/react-toggle-group": "^1.1.19",
        "@radix-ui/react-tooltip": "^1.2.16",
        "@tailwindcss/vite": "^4.1.18",
        "@tanstack/react-virtual": "^3.14.13",
        "@types/better-sqlite3": "^7.6.13",
        "@types/d3-force": "^3.0.10",
        "@types/node": "^24.0.0",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@vitejs/plugin-react": "5.2.0",
        "@xterm/addon-fit": "^0.10.0",
        "@xterm/xterm": "^5.5.0",
        "@xyflow/react": "^12.11.0",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "d3-force": "^3.0.0",
        "dompurify": "^3.2.4",
        "electron": "^44.4.5",
        "electron-builder": "^26.15.3",
        "electron-vite": "^5.0.0",
        "eslint": "^9.39.0",
        "lucide-react": "^1.48.0",
        "marked": "^18.0.14",
        "prettier": "^3.6.2",
        "react": "^19.1.0",
        "react-dom": "^19.1.0",
        "tailwindcss": "^4.1.18",
        "tailwind-merge": "^3.3.1",
        "typescript": "5.9.3",
        "typescript-eslint": "^8.46.0",
        "vite": "^7.1.0",
        "vitest": "^5.0.2",
        "zustand": "^5.0.8"
    },
    "allowScripts": {
        "better-sqlite3@13.0.3": true,
        "esbuild@0.25.12": true,
        "esbuild@0.28.2": true
    }
}
